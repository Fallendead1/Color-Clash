{
  "name": "Color Clash",
  "globIgnorePaths": [
    "src/server/Dev",
    "src/server/Dev/**",
    "src/shared/Dev",
    "src/shared/Dev/**",
    "src/client/Dev",
    "src/client/Dev/**"
  ],
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    }
  }
}
