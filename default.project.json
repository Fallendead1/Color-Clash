{
  "name": "Color Clash",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "ColorClashAssets": {
        "$path": "assets/presentation/ColorClashAssets.rbxmx"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "ServerStorage": {
      "ColorClashMaps": {
        "$path": "assets/maps/ColorClashMaps.rbxmx"
      }
    },
    "Workspace": {
      "$ignoreUnknownInstances": true,
      "ColorClashStaging": {
        "$path": "assets/staging/ColorClashStaging.rbxmx"
      }
    },
    "StarterGui": {
      "ColorClashUI": {
        "$path": "assets/ui/ColorClashUI.rbxmx"
      }
    }
  }
}
